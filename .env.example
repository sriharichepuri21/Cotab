# App
APP_NAME=ReceiptWise API
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=dev-secret-change-me-in-prod

# Database (local default: SQLite; Supabase/Render hand out postgres:// —
# it's normalized to postgresql+psycopg2:// automatically)
DATABASE_URL=sqlite:///./receiptwise.db
# Optional: separate read-role DSN for the chat tool queries. Defaults to DATABASE_URL.
DATABASE_URL_READONLY=

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage — LocalStack by default; set S3_ENDPOINT_URL="" for real AWS S3,
# or a Supabase S3-compatible endpoint (see docs/SUPABASE_S3.md)
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=receiptwise-uploads

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Second read for receipts the everyday model wasn't sure of (empty = off)
GEMINI_UPGRADE_MODEL=gemini-3.8-flash
# Daily AI spending caps in USD, estimated at paid-tier prices
AI_USER_DAILY_BUDGET_USD=0.25
AI_DAILY_BUDGET_USD=3.00

# Email forwarding via Resend inbound (off until all three are set)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=

# Rate limits & policy
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_EXECUTE_SQL_PER_HOUR=60
# Production: provision Redis and set its TLS URL. When configured, limiter
# failures reject expensive AI/SQL work instead of silently becoming unlimited.
REDIS_URL=
RATE_LIMIT_KEY_PREFIX=receiptwise:rate-limit
RATE_LIMIT_FAIL_CLOSED=true
SOFT_DELETE_GRACE_DAYS=30

# Cron endpoints
CRON_SECRET=dev-cron-secret
