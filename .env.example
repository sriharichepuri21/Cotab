# App
APP_NAME=ReceiptWise API
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=dev-secret-change-me-in-prod

# Database (local default: SQLite; for Postgres use postgresql+psycopg2://user:pass@localhost:5432/receiptwise)
DATABASE_URL=sqlite:///./receiptwise.db

# AWS / LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=receiptwise-uploads

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rate limits & policy
RATE_LIMIT_CHAT_PER_HOUR=20
SOFT_DELETE_GRACE_DAYS=30

# Cron endpoints
CRON_SECRET=dev-cron-secret
