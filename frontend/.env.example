# copy to .env.local for dev, or set NEXT_PUBLIC_API_URL in Vercel
#
# Use "localhost", NOT "127.0.0.1". The dev server runs on localhost:3000, and
# the browser treats localhost and 127.0.0.1 as different hosts — that makes the
# API call cross-site, and the SameSite=Lax session cookie is then never sent.
# Login appears to work and every subsequent request 401s. Ports don't affect
# same-site, so localhost:3000 -> localhost:8000 is fine.
NEXT_PUBLIC_API_URL=http://localhost:8000
